PORT=5000

# Local dev (MongoDB on your machine):
# MONGODB_URI=mongodb://localhost:27017/todoapp
#
# AWS / production (MongoDB Atlas — create cluster at cloud.mongodb.com):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/todoapp?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/todoapp

# CORS — set to your public app URL in production (NLB DNS from kubectl get svc)
# Example: http://a1b2c3d4.ap-south-1.elb.amazonaws.com
FRONTEND_URL=http://localhost:5173
