      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "{namespace=\"todo-app\", app=\"backend\"} |~ \"(?i)(\\\\[ERROR\\\\]|error|exception|Mongoose|MongoDB|CORS)\"",
        "refId": "A"
      }]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
