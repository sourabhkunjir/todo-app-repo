        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "{namespace=\"todo-app\", app=\"backend\"} |~ \"^(GET|POST|PATCH|DELETE|PUT|OPTIONS) \"",
        "refId": "A"
      }]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 22 },
